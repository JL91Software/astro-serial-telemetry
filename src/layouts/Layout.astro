---
import Header from "../components/Header.astro";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- SEO Básico Dinámico -->
		<title>{title} | JL91 Software</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:title" content={`${title} | JL91 Software`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;600;800&display=swap"
			rel="stylesheet"
		/>

		<!-- Bootstrap 5 CDN -->
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
			crossorigin="anonymous"
		/>

		<!-- Bootstrap Icons (Para el icono de GitHub, Web, etc.) -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

		<!-- Chart.js -->
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>

	<body>
		<!-- Encabezado -->
		<Header />

		<!-- Contenido -->
		<slot />
	</body>
</html>

<style is:global>
    :root {
        --bg-color: #0b0f19;
        --accent-cyan: #00F3FF;
        --accent-magenta: #FF00E5;
        --accent-cyan-dim: rgba(0, 243, 255, 0.15);
        --panel-bg: rgba(15, 23, 42, 0.7);
        --border-color: rgba(0, 243, 255, 0.3);
        --text-main: #e2e8f0;
        --text-muted: #94a3b8;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        background-image: 
            linear-gradient(var(--accent-cyan-dim) 1px, transparent 1px),
            linear-gradient(90deg, var(--accent-cyan-dim) 1px, transparent 1px);
        background-size: 30px 30px;
        background-position: center center;
    }

    /* Utilidades */
    .text-cyan { color: var(--accent-cyan) !important; }
    .border-cyan { border-color: var(--border-color) !important; }
    
    /* Navbar y Enlaces */
    .navbar-lab {
        background: rgba(11, 15, 25, 0.9);
        border-bottom: 1px solid var(--border-color);
        backdrop-filter: blur(10px);
    }

    .nav-link-custom {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 500;
    }

    .nav-link-custom:hover {
        color: var(--accent-cyan);
    }

    /* Paneles y Botones */
    .glass-panel {
        background: var(--panel-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        backdrop-filter: blur(5px);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
    }

    .btn-cyan {
        background-color: transparent;
        color: var(--accent-cyan);
        border: 1px solid var(--accent-cyan);
        box-shadow: 0 0 10px rgba(0, 243, 255, 0.1);
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .btn-cyan:hover, .btn-cyan:not(:disabled):active {
        background-color: var(--accent-cyan);
        color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 243, 255, 0.4);
    }

    .btn-cyan:disabled {
        border-color: var(--text-muted);
        color: var(--text-muted);
        box-shadow: none;
    }

    .btn-simulate {
        background: transparent;
        color: var(--accent-magenta);
        border: 1px dashed var(--accent-magenta);
        font-size: 0.8rem;
    }

    .btn-simulate:hover { 
        background: rgba(255, 0, 229, 0.1); 
        color: var(--accent-magenta);
    }

    /* Terminal */
    .terminal-window {
        background-color: #05080f;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 15px;
        flex-grow: 1;
        height: 250px; 
        overflow-y: auto;
        font-family: 'Fira Code', monospace;
        color: var(--accent-cyan);
        font-size: 0.85rem;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
    }

    .terminal-window p { margin-bottom: 2px; line-height: 1.4; }
    .terminal-window::-webkit-scrollbar { width: 8px; }
    .terminal-window::-webkit-scrollbar-track { background: #05080f; }
    .terminal-window::-webkit-scrollbar-thumb { background: var(--accent-cyan-dim); border-radius: 4px; }
    
    /* Indicadores y Forms */
    .led-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        box-shadow: 0 0 8px currentColor;
    }
    .led-red { background-color: #ff3366; color: #ff3366; }
    .led-green { background-color: #00ff66; color: #00ff66; }

    .form-select-lab { 
        background-color: #05080f; 
        border: 1px solid var(--border-color); 
        color: var(--accent-cyan); 
    }
    .chart-container { position: relative; height: 250px; width: 100%; }
</style>
