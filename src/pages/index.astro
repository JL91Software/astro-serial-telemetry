---
import Layout from "../layouts/Layout.astro";
---

<Layout 
    title="Astro Serial Telemetry Base" 
    description="Con este proyecto puedes leer datos por de telemetría de controladores Arduino/ESP32 desde USB sin necesidad de instalar servidores locales, Node.js en el backend, ni bases de datos. Simplemente conecta, abre la web y visualiza."
    >
	<main class="container-fluid py-3 px-4">
		<div class="row g-3">
			<!-- Columna Izquierda: Controles y Terminal -->
			<div class="col-12 col-lg-4 d-flex flex-column gap-3">
				<!-- Panel de Control -->
				<div class="glass-panel p-3">
					<h6 class="text-cyan mb-3">
						<i class="bi bi-sliders"></i> Control de Enlace
					</h6>
					<div class="row g-2 mb-3">
						<div class="col-12">
							<select
								id="baudRate"
								class="form-select form-select-sm form-select-lab"
							>
								<option value="9600">9600 bps</option>
								<option value="115200" selected
									>115200 bps</option
								>
							</select>
						</div>
					</div>
					<div class="d-flex gap-2">
						<button
							id="btnConnect"
							class="btn btn-sm btn-cyan flex-grow-1"
							>Conectar</button
						>
						<button
							id="btnDisconnect"
							class="btn btn-sm btn-cyan flex-grow-1"
							disabled>Desconectar</button
						>
					</div>

					<!-- Botón para probar la UI sin hardware -->
					<button
						id="btnTest"
						class="btn btn-sm btn-simulate mt-3 w-100"
						>Simular Datos JSON (Prueba UI)</button
					>
				</div>

				<!-- Panel de Terminal -->
				<div class="glass-panel p-3 flex-grow-1">
					<div
						class="d-flex justify-content-between align-items-center mb-2"
					>
						<h6 class="text-cyan m-0">RX Monitor</h6>
						<button
							id="btnClear"
							class="btn btn-sm btn-outline-secondary py-0"
							style="font-size:0.7rem;">Limpiar</button
						>
					</div>
					<div id="terminal" class="terminal-window">
						<p class="text-muted">// Esperando datos...</p>
						<p class="text-muted">
							// Si recibo JSON, actualizaré las gráficas
							automáticamente.
						</p>
					</div>
				</div>
			</div>

			<!-- Columna Derecha: Gráficas -->
			<div class="col-12 col-lg-8 d-flex flex-column gap-3">
				<!-- Gráfica 1: Histórico (Línea) -->
				<div class="glass-panel p-3">
					<h6 class="text-cyan mb-2">Tendencia: Temperatura (°C)</h6>
					<div class="chart-container">
						<canvas id="lineChart"></canvas>
					</div>
				</div>

				<!-- Gráfica 2 y 3: Indicadores actuales (Barras / Gauge simulado) -->
				<div class="row g-3">
					<div class="col-12 col-md-6">
						<div class="glass-panel p-3 h-100">
							<h6 class="text-cyan mb-2">Humedad (%)</h6>
							<div class="chart-container" style="height: 200px;">
								<canvas id="barChart"></canvas>
							</div>
						</div>
					</div>
					<div class="col-12 col-md-6">
						<div
							class="glass-panel p-3 h-100 d-flex flex-column align-items-center justify-content-center"
						>
							<h6 class="mb-1">Última lectura RPM</h6>
							<h1
								id="rpmValue"
								class="text-cyan fw-bold display-3"
								style="text-shadow: 0 0 15px rgba(0,243,255,0.5);"
							>
								0
							</h1>
							<span class="small">Rev/min</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
    // --- 0. DECLARACIÓN PARA TYPESCRIPT ---
    // Le decimos a VS Code que "Chart" existe globalmente (Cargado vía CDN)
    declare const Chart: any;

    // --- 1. CONFIGURACIÓN DE CHART.JS (TEMA DARK) ---
    Chart.defaults.color = '#94a3b8';
    Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.1)';
    Chart.defaults.font.family = 'Inter';

    // Gráfica de Línea (Temperatura a lo largo del tiempo)
    const canvasLine = document.getElementById('lineChart') as HTMLCanvasElement;
    const ctxLine = canvasLine.getContext('2d');
    
    const lineChart = new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: [], 
            datasets: [{
                label: 'Temp (°C)',
                data: [],
                borderColor: '#00F3FF',
                backgroundColor: 'rgba(0, 243, 255, 0.1)',
                borderWidth: 2,
                pointRadius: 0, 
                tension: 0.4,   
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { suggestedMin: 15, suggestedMax: 40 }, 
                x: { display: false } 
            },
            animation: { duration: 0 } 
        }
    });

    // Gráfica de Barras (Humedad actual)
    const canvasBar = document.getElementById('barChart') as HTMLCanvasElement;
    const ctxBar = canvasBar.getContext('2d');
    
    const barChart = new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: ['Humedad'],
            datasets: [{
                label: '%',
                data: [0],
                backgroundColor: '#FF00E5',
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { min: 0, max: 100 }
            },
            plugins: { legend: { display: false } }
        }
    });

    const rpmValueDisplay = document.getElementById('rpmValue') as HTMLElement;
    const maxDataPoints = 50; 

    // Tipamos dataObj como 'any' para calmar a TypeScript
    function updateCharts(dataObj: any) {
        if (dataObj.temp !== undefined) {
            lineChart.data.labels.push(''); 
            lineChart.data.datasets[0].data.push(dataObj.temp);
            if (lineChart.data.labels.length > maxDataPoints) {
                lineChart.data.labels.shift();
                lineChart.data.datasets[0].data.shift();
            }
            lineChart.update();
        }

        if (dataObj.hum !== undefined) {
            barChart.data.datasets[0].data[0] = dataObj.hum;
            barChart.update();
        }

        if (dataObj.rpm !== undefined) {
            rpmValueDisplay.innerText = dataObj.rpm;
        }
    }

    // --- 2. LÓGICA DEL TERMINAL ---
    const terminal = document.getElementById('terminal') as HTMLElement;
    
    // Tipamos los parámetros de la función
    function logToTerminal(text: string, type: string = 'data') {
        const p = document.createElement('p');
        if (type === 'system') p.style.color = '#94a3b8';
        else if (type === 'error') p.style.color = '#ff3366';
        else p.innerText = text;
        
        if(type !== 'data') p.innerText = `// ${text}`;
        
        terminal.appendChild(p);
        terminal.scrollTop = terminal.scrollHeight; 
    }

    // --- 3. LÓGICA WEB SERIAL API ---
    let port: any, reader: any, inputDone: any, inputStream: any;
    
    const btnConnect = document.getElementById('btnConnect') as HTMLButtonElement;
    const btnDisconnect = document.getElementById('btnDisconnect') as HTMLButtonElement;
    const led = document.getElementById('led') as HTMLElement;
    const statusText = document.getElementById('statusText') as HTMLElement;
    const baudRateSelect = document.getElementById('baudRate') as HTMLSelectElement;

    async function connectSerial() {
        if (!("serial" in navigator)) {
            alert("Web Serial API no soportada en este navegador.");
            return;
        }
        try {
            port = await (navigator as any).serial.requestPort();
            await port.open({ baudRate: parseInt(baudRateSelect.value) });
            
            led.classList.replace('led-red', 'led-green');
            statusText.innerText = 'Conectado';
            btnConnect.disabled = true;
            btnDisconnect.disabled = false;
            logToTerminal("Puerto abierto. Esperando telemetría...", 'system');

            const decoder = new TextDecoderStream();
            inputDone = port.readable.pipeTo(decoder.writable);
            inputStream = decoder.readable;
            reader = inputStream.getReader();

            readLoop();
        } catch (err: any) {
            logToTerminal("Error: " + err.message, "error");
        }
    }

    async function readLoop() {
        let buffer = '';
        while (true) {
            try {
                const { value, done } = await reader.read();
                if (done) { reader.releaseLock(); break; }
                if (value) {
                    buffer += value;
                    const lines = buffer.split('\n');
                    if (lines.length > 1) {
                        for (let i = 0; i < lines.length - 1; i++) {
                            const cleanLine = lines[i].trim();
                            if(cleanLine.length === 0) continue;
                            
                            logToTerminal(cleanLine); 
                            
                            try {
                                const parsedData = JSON.parse(cleanLine);
                                updateCharts(parsedData); 
                            } catch (e) {
                                // Silencioso
                            }
                        }
                        buffer = lines[lines.length - 1];
                    }
                }
            } catch (error) {
                break;
            }
        }
    }

    async function disconnectSerial() {
        if (reader) {
            await reader.cancel();
            await inputDone.catch(() => {});
            reader = null;
        }
        if (port) {
            await port.close();
            port = null;
        }
        led.classList.replace('led-green', 'led-red');
        statusText.innerText = 'Desconectado';
        btnConnect.disabled = false;
        btnDisconnect.disabled = true;
        logToTerminal("Puerto cerrado.", "system");
    }

    btnConnect.addEventListener('click', connectSerial);
    btnDisconnect.addEventListener('click', disconnectSerial);
    
    const btnClear = document.getElementById('btnClear');
    if(btnClear) {
        btnClear.addEventListener('click', () => terminal.innerHTML = '');
    }

    // --- 4. SIMULADOR PARA PRUEBAS ---
    let simInterval: any;
    let simTemp = 25;
    const btnTest = document.getElementById('btnTest');
    
    if(btnTest) {
        btnTest.addEventListener('click', function(this: HTMLElement) {
            if (simInterval) {
                clearInterval(simInterval);
                simInterval = null;
                this.innerText = "Simular Datos JSON (Prueba UI)";
                logToTerminal("Simulación detenida.", "system");
                return;
            }
            
            this.innerText = "Detener Simulación";
            logToTerminal("Simulación iniciada...", "system");
            
            simInterval = setInterval(() => {
                simTemp += (Math.random() - 0.5) * 2;
                const fakeData = {
                    temp: parseFloat(simTemp.toFixed(2)),
                    hum: Math.floor(Math.random() * (80 - 40 + 1) + 40), 
                    rpm: Math.floor(Math.random() * (1500 - 1000 + 1) + 1000) 
                };
                
                const jsonString = JSON.stringify(fakeData);
                logToTerminal(jsonString); 
                updateCharts(fakeData);    
                
            }, 500); 
        });
    }
</script>